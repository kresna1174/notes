# =========================================================================
# Notes Platform Production Environment Configuration
# Copy this file to '.env' in the same directory and fill in your keys.
# =========================================================================

# --- PostgreSQL Configuration ---
POSTGRES_DB=notesdb
POSTGRES_USER=notes
POSTGRES_PASSWORD=your_strong_password_here
DATABASE_URL=postgresql://notes:your_strong_password_here@localhost:5432/notesdb

# --- OpenRouter API Configuration ---
# Required: Insert your actual OpenRouter API key here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: AI model to use (defaults to Google Gemini 2.5 Flash Free)
OPENROUTER_MODEL=google/gemini-2.5-flash:free

# Optional: OpenRouter base API URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OAuth (better-auth) ---
BETTER_AUTH_SECRET=change-me-32-chars-minimum-random
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Langfuse Observability (optional) ---
# Get keys from cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Email / SMTP (for forgot password) ---
# Leave SMTP_HOST empty in dev — reset links will be logged to console instead
# Gmail: use App Password (myaccount.google.com/apppasswords), port 587, SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
